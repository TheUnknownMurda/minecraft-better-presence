# Copier en .env et renseigner l'App ID (portail developpeur Discord).
DISCORD_APP_ID=
# Langue affichee dans Discord : en ou fr.
PRESENCE_LANG=en
# Grande image (URL https) pour une partie RLCraft et le menu qui la suit ;
# vide : la dimension en jeu, un bloc d'herbe au menu.
RLCRAFT_IMAGE=
# 1 pour afficher les coordonnees au survol de la grande image.
SHOW_COORDS=0
# 0 pour une connexion WebSocket en clair (debogage uniquement).
ENCRYPTION=1
# 1 pour enregistrer les scoreboards et tags RLCraft dans logs/rlcraft-trace.jsonl.
TRACE_RLCRAFT=0
